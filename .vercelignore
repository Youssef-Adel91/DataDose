# ============================================================
# .vercelignore  —  DataDose Python backend deployment
# ============================================================
# This file works like .gitignore but for Vercel uploads.
# Files listed here are NEVER sent to Vercel, keeping the
# Python serverless function well under the 225 MB hard limit.
#
# CRITICAL: Do NOT add *.txt or backend/requirements.txt here.
# Vercel's @vercel/python builder REQUIRES backend/requirements.txt
# to know which packages to install. Excluding it causes
# ModuleNotFoundError for every import at runtime.
# ============================================================

# ── Next.js frontend (deployed separately) ─────────────────
DataDose_website-main/

# ── Binary / media files that bloat the bundle ─────────────
Documents/
*.pptx
*.pdf
*.mp4
*.mkv
*.avi
*.mov
*.crdownload
*.xlsx
*.xls
*.zip
*.tar
*.gz
*.whl
*.ipynb
*.mp3
*.wav

# ── Data engineering modules (not used by the API) ─────────
Airflow/
Kafka/
SnowFlake/
Databricks_Pyspark/
Neo4j/
Data/
Power Bi/
Pipline Diagram/
Cleaning Code/
assets/

# ── Databases / local runtime state ────────────────────────
neo4j_data/

# ── Python build artifacts ──────────────────────────────────
backend/venv/
backend/__pycache__/
backend/get-pip.py
backend/start_backend.bat
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.egg-info/
**/.pytest_cache/

# ── Git ─────────────────────────────────────────────────────
.git/

# ── Misc project files (safe to exclude — not needed by runtime) ─
docker-compose.yml
pyproject.toml
# Root-level requirements.txt (not the one in backend/)
/requirements.txt
*.md

# Specific .txt files that are safe to exclude
DataDose_website-main/test_output.txt
Airflow/requirements.txt
