# ============================================================
# .vercelignore  —  DataDose monorepo (global, both projects)
# ============================================================
# This file is applied GLOBALLY by Vercel before any builder runs.
# It affects BOTH the Python backend AND the Next.js frontend.
#
# ⚠ RULES:
#   1. Do NOT put DataDose_website-main/ here — the Next.js Vercel
#      project needs those files to build. Frontend exclusions from
#      the Python bundle belong in vercel.json → excludeFiles only.
#   2. Do NOT put *.txt or backend/requirements.txt here — the
#      @vercel/python builder requires that file to install packages.
# ============================================================

# ── Binary / media files (safe to ignore for ALL projects) ──
# These files are never needed by either the Python or Next.js builds.
Documents/
*.pptx
*.mp4
*.mkv
*.avi
*.mov
*.crdownload
*.xlsx
*.xls
*.zip
*.tar
*.gz
*.whl
*.mp3
*.wav

# ── Data engineering modules (not part of any deployment) ───
Airflow/
Kafka/
SnowFlake/
Databricks_Pyspark/
Neo4j/
Data/
Power Bi/
Pipline Diagram/
Cleaning Code/
assets/

# ── Databases / local runtime state ─────────────────────────
neo4j_data/

# ── Python build artifacts ───────────────────────────────────
backend/venv/
backend/__pycache__/
backend/get-pip.py
backend/start_backend.bat
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.egg-info/
**/.pytest_cache/

# ── Git internals ────────────────────────────────────────────
.git/

# ── Misc project-level files (not needed by any runtime) ────
docker-compose.yml
pyproject.toml
/requirements.txt
