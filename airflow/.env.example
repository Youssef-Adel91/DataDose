# DataDose — Airflow bootstrap configuration ONLY.
# Pipeline secrets (Kafka, Snowflake, Neo4j, Databricks) are NOT here —
# they're created as Airflow Connections after the stack starts.
# See DEPLOYMENT_GUIDE.md and ARCHITECTURE.md for why.

AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_WEBSERVER_HOST_PORT=8081

# Local path to ca.pem, mounted read-only into every Airflow container
# (this is a file, not a secret string, so it stays outside Connections).
CA_PEM_LOCAL_PATH=../certs/ca.pem

# Producer simulator container (runs continuously via Docker, not Airflow).
# These ARE pipeline secrets, but the producer isn't an Airflow-managed
# component, so it keeps its own env here rather than an Airflow Connection.
KAFKA_BOOTSTRAP_SERVERS=datadosekafka-901-datadosedepiproject001.l.aivencloud.com:15807
KAFKA_TOPIC=DataDose.in
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
