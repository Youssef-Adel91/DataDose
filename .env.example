KAFKA_BOOTSTRAP_SERVERS=datadosekafka-901-datadosedepiproject001.l.aivencloud.com:15816
KAFKA_TOPIC=DataDose.in
KAFKA_USERNAME=<KAFKA_USERNAME>
KAFKA_PASSWORD=<KAFKA_PASSWORD>
KAFKA_CA_PEM_PATH=Kafka/certs/ca.pem
KAFKA_CA_FILE=Kafka/certs/ca.pem
KAFKA_CLIENT_ID=CONSUMER_CLIENT_ID
KAFKA_GROUP_ID=CONSUMER_GROUP_ID
KAFKA_SASL_MECHANISM=SCRAM-SHA-256

NEO4J_URI=<NEO4J_URI>
NEO4J_USER=<NEO4J_USER>
NEO4J_PASSWORD=<NEO4J_PASSWORD>

SNOWFLAKE_URL=<SNOWFLAKE_URL>
SNOWFLAKE_USER=<SNOWFLAKE_USER>
SNOWFLAKE_PASSWORD=<SNOWFLAKE_PASSWORD>
SNOWFLAKE_DATABASE=PHARMA_ANALYTICS_DB
SNOWFLAKE_SCHEMA=STAGING
SNOWFLAKE_WAREHOUSE=PHARMA_WH
SNOWFLAKE_ROLE=PYSPARK_ROLE

DATASET_PATH=Kafka/output_FINAL.csv
DATABRICKS_SECRET_SCOPE=datadose

# ── Sprint 2: Databricks ML Risk Scoring ─────────────────────────────────────
# The numeric Job ID of the Databricks notebook that scores drug risk.
# Create the job in the Databricks UI first, then set this.
DATABRICKS_HOST=https://<workspace-id>.azuredatabricks.net
DATABRICKS_TOKEN=<DATABRICKS_TOKEN>
DATABRICKS_RISK_JOB_ID=<DATABRICKS_JOB_ID>

# ── Sprint 3: Snowflake Microservice (Next.js proxy → Railway/Render) ─────────
# Set in the Next.js Vercel project only (server-side — no NEXT_PUBLIC_ prefix).
SNOWFLAKE_MICROSERVICE_URL=https://your-snowflake-service.railway.app

# ── Sprint 2: FDA Alerts SSE (useFdaAlerts hook) ─────────────────────────────
# Set in the Next.js Vercel project with the NEXT_PUBLIC_ prefix so the
# React hook can read it client-side.
NEXT_PUBLIC_BACKEND_URL=https://your-fastapi-backend.vercel.app